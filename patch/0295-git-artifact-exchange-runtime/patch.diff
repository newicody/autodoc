@@ -0,0 +1,226 @@
+name: Autodoc one-shot Copilot refinement
+
+on:
+  push:
+    branches:
+      - "**"
+    paths:
+      - "autodoc/exchanges/issues/**/cycles/**/server-response.json"
+
+permissions:
+  contents: read
+  copilot-requests: write
+
+concurrency:
+  group: autodoc-copilot-refinement-${{ github.event.repository.name }}-${{ github.sha }}
+  cancel-in-progress: false
+
+jobs:
+  refine-once:
+    if: ${{ github.repository == 'newicody/projects' }}
+    runs-on: ubuntu-latest
+    env:
+      AUTODOC_COPILOT_CLI_VERSION: "1.0.70"
+      AUTODOC_COPILOT_CLI_PREFIX: ${{ github.workspace }}/.cache/copilot-cli
+    steps:
+      - name: Checkout Projects repository
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ github.ref_name }}
+
+      - name: Checkout Autodoc runtime
+        uses: actions/checkout@v6
+        with:
+          repository: newicody/autodoc
+          ref: docs/unification-027x
+          path: autodoc-runtime
+
+      - name: Resolve Issue and cycle from pushed path
+        id: exchange
+        shell: bash
+        run: |
+          set -euo pipefail
+          match="$(
+            jq -r '.commits[]? | (.added[]?, .modified[]?)' "$GITHUB_EVENT_PATH" \
+              | grep -E '^autodoc/exchanges/issues/[0-9]+/cycles/[0-9]+/server-response\.json
+      - name: Restore pinned Copilot CLI
+        id: copilot-cache
+        uses: actions/cache@v4
+        with:
+          path: ${{ env.AUTODOC_COPILOT_CLI_PREFIX }}
+          key: autodoc-copilot-cli-v1-${{ runner.os }}-${{ runner.arch }}-${{ env.AUTODOC_COPILOT_CLI_VERSION }}
+
+      - name: Install pinned Copilot CLI on cache miss
+        if: ${{ steps.copilot-cache.outputs.cache-hit != 'true' }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          npm install --prefix "$AUTODOC_COPILOT_CLI_PREFIX" --no-audit --no-fund --omit=dev "@github/copilot@$AUTODOC_COPILOT_CLI_VERSION"
+
+      - name: Verify pinned Copilot CLI
+        shell: bash
+        run: |
+          set -euo pipefail
+          actual_version="$(node -p "require(process.env.AUTODOC_COPILOT_CLI_PREFIX + '/node_modules/@github/copilot/package.json').version")"
+          test "$actual_version" = "$AUTODOC_COPILOT_CLI_VERSION"
+          test -x "$AUTODOC_COPILOT_CLI_PREFIX/node_modules/.bin/copilot"
+
+      - name: Require Git exchange publication token
+        shell: bash
+        env:
+          AUTODOC_EXCHANGE_GIT_TOKEN: ${{ secrets.AUTODOC_EXCHANGE_GIT_TOKEN }}
+        run: |
+          set -euo pipefail
+          test -n "$AUTODOC_EXCHANGE_GIT_TOKEN"
+
+      - name: Fetch initial Copilot artifact from Git
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PYTHONPATH: autodoc-runtime/src
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/fetch_git_exchange_artifact.py \
+            --repository "$GITHUB_REPOSITORY" \
+            --branch "$GITHUB_REF_NAME" \
+            --issue-number "${{ steps.exchange.outputs.issue_number }}" \
+            --cycle-ordinal "${{ steps.exchange.outputs.cycle_ordinal }}" \
+            --role copilot_initial \
+            --output out/copilot-initial.json
+
+      - name: Fetch server response from Git
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PYTHONPATH: autodoc-runtime/src
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/fetch_git_exchange_artifact.py \
+            --repository "$GITHUB_REPOSITORY" \
+            --branch "$GITHUB_REF_NAME" \
+            --issue-number "${{ steps.exchange.outputs.issue_number }}" \
+            --cycle-ordinal "${{ steps.exchange.outputs.cycle_ordinal }}" \
+            --role server_response \
+            --output out/server-response.json
+
+      - name: Ask Copilot for the single refinement
+        env:
+          PYTHONPATH: autodoc-runtime/src
+          COPILOT_AUTO_UPDATE: "false"
+          AUTODOC_COPILOT_COMMAND: ${{ env.AUTODOC_COPILOT_CLI_PREFIX }}/node_modules/.bin/copilot
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/run_autodoc_copilot_refinement.py \
+            --initial-envelope out/copilot-initial.json \
+            --server-response-envelope out/server-response.json \
+            --output out/copilot-refined.json
+
+      - name: Push refined Copilot artifact to Git
+        env:
+          GH_TOKEN: ${{ secrets.AUTODOC_EXCHANGE_GIT_TOKEN }}
+          PYTHONPATH: autodoc-runtime/src
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/publish_git_exchange_artifact.py \
+            --repository "$GITHUB_REPOSITORY" \
+            --branch "$GITHUB_REF_NAME" \
+            --issue-number "${{ steps.exchange.outputs.issue_number }}" \
+            --cycle-ordinal "${{ steps.exchange.outputs.cycle_ordinal }}" \
+            --role copilot_refined \
+            --payload out/copilot-refined.json \
+            --initial-envelope out/copilot-initial.json \
+            --server-response-envelope out/server-response.json
+ \
+              | head -n1 || true
+          )"
+          test -n "$match"
+          issue_number="$(printf '%s\n' "$match" | sed -E 's#autodoc/exchanges/issues/([0-9]+)/cycles/([0-9]+)/server-response\.json#\1#')"
+          cycle_ordinal="$(printf '%s\n' "$match" | sed -E 's#autodoc/exchanges/issues/[0-9]+/cycles/([0-9]+)/server-response\.json#\1#')"
+          test -n "$issue_number"
+          test -n "$cycle_ordinal"
+          echo "issue_number=$issue_number" >> "$GITHUB_OUTPUT"
+          echo "cycle_ordinal=$cycle_ordinal" >> "$GITHUB_OUTPUT"
+
+      - name: Restore pinned Copilot CLI
+        id: copilot-cache
+        uses: actions/cache@v4
+        with:
+          path: ${{ env.AUTODOC_COPILOT_CLI_PREFIX }}
+          key: autodoc-copilot-cli-v1-${{ runner.os }}-${{ runner.arch }}-${{ env.AUTODOC_COPILOT_CLI_VERSION }}
+
+      - name: Install pinned Copilot CLI on cache miss
+        if: ${{ steps.copilot-cache.outputs.cache-hit != 'true' }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          npm install --prefix "$AUTODOC_COPILOT_CLI_PREFIX" --no-audit --no-fund --omit=dev "@github/copilot@$AUTODOC_COPILOT_CLI_VERSION"
+
+      - name: Verify pinned Copilot CLI
+        shell: bash
+        run: |
+          set -euo pipefail
+          actual_version="$(node -p "require(process.env.AUTODOC_COPILOT_CLI_PREFIX + '/node_modules/@github/copilot/package.json').version")"
+          test "$actual_version" = "$AUTODOC_COPILOT_CLI_VERSION"
+          test -x "$AUTODOC_COPILOT_CLI_PREFIX/node_modules/.bin/copilot"
+
+      - name: Require Git exchange publication token
+        shell: bash
+        env:
+          AUTODOC_EXCHANGE_GIT_TOKEN: ${{ secrets.AUTODOC_EXCHANGE_GIT_TOKEN }}
+        run: |
+          set -euo pipefail
+          test -n "$AUTODOC_EXCHANGE_GIT_TOKEN"
+
+      - name: Fetch initial Copilot artifact from Git
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PYTHONPATH: autodoc-runtime/src
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/fetch_git_exchange_artifact.py \
+            --repository "$GITHUB_REPOSITORY" \
+            --branch "$GITHUB_REF_NAME" \
+            --issue-number "${{ steps.exchange.outputs.issue_number }}" \
+            --cycle-ordinal "${{ steps.exchange.outputs.cycle_ordinal }}" \
+            --role copilot_initial \
+            --output out/copilot-initial.json
+
+      - name: Fetch server response from Git
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PYTHONPATH: autodoc-runtime/src
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/fetch_git_exchange_artifact.py \
+            --repository "$GITHUB_REPOSITORY" \
+            --branch "$GITHUB_REF_NAME" \
+            --issue-number "${{ steps.exchange.outputs.issue_number }}" \
+            --cycle-ordinal "${{ steps.exchange.outputs.cycle_ordinal }}" \
+            --role server_response \
+            --output out/server-response.json
+
+      - name: Ask Copilot for the single refinement
+        env:
+          PYTHONPATH: autodoc-runtime/src
+          COPILOT_AUTO_UPDATE: "false"
+          AUTODOC_COPILOT_COMMAND: ${{ env.AUTODOC_COPILOT_CLI_PREFIX }}/node_modules/.bin/copilot
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/run_autodoc_copilot_refinement.py \
+            --initial-envelope out/copilot-initial.json \
+            --server-response-envelope out/server-response.json \
+            --output out/copilot-refined.json
+
+      - name: Push refined Copilot artifact to Git
+        env:
+          GH_TOKEN: ${{ secrets.AUTODOC_EXCHANGE_GIT_TOKEN }}
+          PYTHONPATH: autodoc-runtime/src
+        run: |
+          set -euo pipefail
+          python autodoc-runtime/tools/publish_git_exchange_artifact.py \
+            --repository "$GITHUB_REPOSITORY" \
+            --branch "$GITHUB_REF_NAME" \
+            --issue-number "${{ steps.exchange.outputs.issue_number }}" \
+            --cycle-ordinal "${{ steps.exchange.outputs.cycle_ordinal }}" \
+            --role copilot_refined \
+            --payload out/copilot-refined.json \
+            --initial-envelope out/copilot-initial.json \
+            --server-response-envelope out/server-response.json
