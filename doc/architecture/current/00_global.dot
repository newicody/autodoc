digraph MissiPy { graph [label="Autodoc/MissiPy — architecture fonctionnelle actuelle",labelloc=t,rankdir=LR,compound=true]; node [shape=box,style=rounded]; subgraph cluster_k {label="Kernel"; Scheduler; PolicyEngine; PriorityQueue; Dispatcher; Registry; EventBus; ContextEngine; Scheduler->PolicyEngine [label="admission"]; Scheduler->PriorityQueue [label="queue"]; Scheduler->Dispatcher [label="dispatch"]; Scheduler->Registry; Scheduler->ContextEngine; Dispatcher->EventBus [label="publish"]; } subgraph cluster_c {label="Recherche / contexte"; ContextServices; Labs; Specialists; GitHub; GitHub->ContextServices [label="workflow externe"]; ContextServices->Labs; ContextServices->Specialists;} subgraph cluster_d {label="Données / inférence"; PostgreSQL; OpenVINO_E5; Qdrant; ContextServices->PostgreSQL [label="durable"]; ContextServices->OpenVINO_E5; OpenVINO_E5->Qdrant [label="384-D"]; Qdrant->PostgreSQL [label="rehydrate refs"];} subgraph cluster_o {label="Observation passive"; CellLensBridge; CellJournal; CellProjection; VisualReadModel; EventBus->CellLensBridge [label="subscribe"]; CellLensBridge->CellJournal [label="append"]; CellJournal->CellProjection [label="replay/read"]; CellProjection->VisualReadModel;} note [shape=note,label="Le graphe de recherche adaptatif, le collecteur matériel et le snapshot serveur Copilot complet restent futurs."]; }