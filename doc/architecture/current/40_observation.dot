digraph Observation {graph[label="Observation cellulaire — raccords présents",labelloc=t,rankdir=LR];node[shape=box,style=rounded];EventBus->CellLensBridge [label="subscribe"];CellLensBridge->CellObservationEvent [label="map"];CellObservationEvent->AppendOnlyJournal [label="missipy.cell.v1"];AppendOnlyJournal->CellProjection [label="read/replay"];CellProjection->PassiveVisualReadModel;VisPyRenderer[shape=note,label="Renderer runtime complet non établi"];PassiveVisualReadModel->VisPyRenderer[style=dashed,label="à vérifier / futur"];HardwareCollector[shape=note,label="collecteur absent"];HardwareCollector->HardwareCell[style=dashed];}