digraph Runtime {graph[label="Runtime et intégrations — frontières",labelloc=t,rankdir=LR];node[shape=box,style=rounded];Scheduler->AuthorizedRouteRequest [label="authorized"];AuthorizedRouteRequest->ControlProxyAdapter [label="transport"];ControlProxyAdapter->ControlFS [label="manifest/root"];ControlProxyAdapter->SharedMemoryRuntime;GitHubActions->ProjectV2 [label="external workflow"];ProjectV2->ContextServices [label="read/projection"];OS->RuntimeProcess [label="lifecycle"];note[shape=note,label="ControlProxy transporte ; OS/OpenRC gère la durée de vie ; intégrations externes non autoritaires."];}